{
  "name": "@seliseblocks/blocks-kit-core",
  "version": "0.0.1",
  "description": "Framework-agnostic core utilities for blocks-kit",
  "keywords": [
    "typescript",
    "core",
    "utilities",
    "http",
    "runtime-env"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    },
    "./runtime-env": {
      "types": "./dist/runtime-env/index.d.ts",
      "import": "./dist/runtime-env/index.js",
      "require": "./dist/runtime-env/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build",
    "clean": "rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "@blocks-kit/eslint-config": "workspace:*",
    "@blocks-kit/tsconfig": "workspace:*",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}