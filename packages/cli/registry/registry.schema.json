{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blocks CLI registry",
  "type": "object",
  "required": ["version", "items"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "generated": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "description",
          "dependencies",
          "registryDependencies",
          "files"
        ],
        "properties": {
          "name": { "type": "string" },
          "kind": { "enum": ["primitive", "block"] },
          "description": { "type": "string" },
          "dependencies": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "registryDependencies": {
            "type": "array",
            "items": { "type": "string" }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "content"],
              "properties": {
                "path": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          },
          "import": { "type": "string" }
        }
      }
    }
  }
}
