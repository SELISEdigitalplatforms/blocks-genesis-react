{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@blocks/typescript-config/base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "downlevelIteration": true,
    "noEmit": true,
    "rootDir": ".",
    "allowImportingTsExtensions": false
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
