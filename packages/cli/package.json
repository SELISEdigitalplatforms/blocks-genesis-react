{
  "name": "@blocks-kit/cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "blocks": "./dist/index.js",
    "blocks-ui": "./dist/index.js"
  },
  "files": ["dist", "registry"],
  "scripts": {
    "build:registry": "tsx scripts/build-registry.ts",
    "build": "tsx scripts/build-registry.ts && tsup && cp -r registry dist/",
    "dev": "tsx src/index.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^13.1.0",
    "fuse.js": "^7.1.0",
    "tsconfck": "^3.1.6"
  },
  "devDependencies": {
    "@blocks-kit/eslint-config": "workspace:*",
    "@blocks-kit/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
